{% extends 'pdf/layout.html.twig' %}
{% block hero_extra %}
  {% if ev.address or ev.venueContact %}<div class="contact">{% if ev.address %}⌂ {{ ev.address }}<br>{% endif %}{{ ev.venueContact|nl2br }}</div>{% endif %}
{% endblock %}
{% block body %}
  {% if weather %}
    <div class="sec"><span class="dot sun"></span>Météo à {{ weather.city }}</div>
    {% if weather.days %}
      <table class="weather"><tr>
        {% for w in weather.days|slice(0, 8) %}
          <td><div class="wd">{{ w.day|fday }}</div><div class="wi">{{ w.icon }}</div><div class="wl">{{ w.label }}</div>
            <div class="wt"><b>{{ w.max }}°</b> / {{ w.min }}°</div>{% if w.rain is not null %}<div class="muted">pluie {{ w.rain }} %</div>{% endif %}</td>
        {% endfor %}
      </tr></table>
    {% endif %}
    <p class="muted" style="margin:3pt 0 0">{% if weather.availableFrom %}Prévisions{{ weather.days ? ' des jours suivants' }} disponibles à partir du {{ weather.availableFrom|fday|lower }} : ouvrez à nouveau la feuille de route pour les voir. {% endif %}Prévisions Open-Meteo.com, données du {{ generatedAt }}.</p>
    <style>
      table.weather { width: 100%; border-collapse: separate; border-spacing: 4pt 0; margin: 0 -4pt; }
      table.weather td { width: 12.5%; padding: 5pt 4pt; border-radius: 8pt; background: {{ theme.sunSoft }}; text-align: center; vertical-align: top; font-size: 7.8pt; }
      table.weather .wd { font-weight: bold; }
      table.weather .wi { font-size: 15pt; line-height: 1.1; margin: 2pt 0; color: {{ theme.ink }}; }
      table.weather .wt { font-size: 9pt; }
    </style>
  {% endif %}
  <div class="sec"><span class="dot mint"></span>Voyages aller</div>
  {% include 'pdf/_trips.html.twig' with { days: outbound, back: false } %}

  <div class="sec"><span class="dot violet"></span>Hébergement</div>
  {% for l in ev.lodgings %}
    <div class="card lodging">
      <h3>{{ l.name }}</h3>
      {% if l.address %}<div>{{ l.address }}</div>{% endif %}
      {% if l.phone %}<div>☎ {{ l.phone }}</div>{% endif %}
      {% if l.website %}<div style="margin-top:3pt"><a class="btn" href="{{ l.website }}">Site web ↗</a></div>{% endif %}
      {% if l.details %}<div class="pre" style="margin-top:3pt">{{ l.details }}</div>{% endif %}
      {% set guests = ev.participations|filter(p => p.lodgingId == l.id)|map(p => p.person.firstName ?: p.person.lastName) %}
      {% if guests|length %}<div class="who">♥ {{ guests|join(', ') }}</div>{% endif %}
    </div>
  {% else %}
    <p class="muted">Aucun hébergement renseigné.</p>
  {% endfor %}

  {% if schedule|length %}
    <div class="sec"><span class="dot sun"></span>Planning</div>
    {% for day, slots in schedule %}
      <div class="day">{{ day|fday }}</div>
      <table class="slots">{% for s in slots %}<tr><td class="h">{{ s.time }}</td><td>{{ [s.label, s.detail ?? '']|filter(v => v)|join(' — ') }}</td></tr>{% endfor %}</table>
    {% endfor %}
  {% endif %}

  {% for s in ev.sections %}
    {% if loop.first %}<div class="sec"><span class="dot coral"></span>Infos pratiques</div>{% endif %}
    <div class="card info"><h3>{{ s.title }}</h3><div class="pre">{{ s.body }}</div></div>
  {% endfor %}

  <div class="sec"><span class="dot coral"></span>Voyages retour</div>
  {% include 'pdf/_trips.html.twig' with { days: inbound, back: true } %}
{% endblock %}
