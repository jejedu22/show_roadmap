{% extends 'pdf/layout.html.twig' %}
{# Une ligne par chambre : une chambre double / twin partagée réunit ses deux occupants #}
{% block body %}
  <table class="grid rooming">
    <thead><tr><th>Occupant(s)</th><th>Fonction</th><th>Chambre</th><th>Hébergement</th>{% for d in ev.dates %}<th class="c">{{ d|ddmm }}</th>{% endfor %}<th class="c">Nuits</th></tr></thead>
    <tbody>
    {% for r in rooms %}
      <tr>
        <td>{% for o in r.occupants %}<b>{{ o.person.fullName }}</b>{% if not loop.last %}<br>{% endif %}{% endfor %}
          {% if r.warning %}<div class="warn">⚠ {{ r.warning }}</div>{% endif %}</td>
        <td>{% for o in r.occupants %}{{ o.role }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td>
        <td>{{ r.type }}{% if r.occupants|length > 1 %}<div class="muted">partagée</div>{% endif %}</td>
        <td>{{ r.lodging }}</td>
        {% for d in ev.dates %}<td class="c">{{ r.nights[d] ? '●' : '' }}</td>{% endfor %}
        <td class="c"><b>{{ r.total }}</b></td>
      </tr>
    {% endfor %}
    </tbody>
    <tfoot>
      <tr><td colspan="4">Personnes logées</td>
        {% for d in ev.dates %}<td class="c">{{ ev.participations|reduce((s, p) => s + (p.days[d].night ?? 0), 0) }}</td>{% endfor %}
        <td class="c">{{ ev.participations|reduce((s, p) => s + (p.days|reduce((t, x) => t + x.night, 0)), 0) }}</td></tr>
      <tr><td colspan="4">Chambres (nuitées prises en charge par l'organisateur)</td>
        {% for d in ev.dates %}<td class="c">{{ rooms|filter(r => r.nights[d])|length }}</td>{% endfor %}
        <td class="c">{{ ev.quote.nightsCount ?? rooms|reduce((s, r) => s + r.total, 0) }}</td></tr>
    </tfoot>
  </table>
  <style>
    table.rooming .warn { margin-top: 2pt; color: {{ theme.coralDark }}; font-size: 7.5pt; font-weight: bold; }
    table.rooming tfoot tr + tr td { border-top: .6pt solid {{ theme.ink }}; }
  </style>
{% endblock %}
