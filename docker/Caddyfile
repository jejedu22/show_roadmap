# TLS géré par Traefik : FrankenPHP écoute en HTTP sur :8080.
{
	frankenphp
	auto_https off
	admin off
}

:8080 {
	root * /app/public
	encode zstd gzip

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Service worker et manifeste (PWA) : toujours revalidés, pour qu'une nouvelle version soit prise aussitôt
	@pwa path /sw.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache"
	header /manifest.webmanifest Content-Type "application/manifest+json"

	# Fichier existant (front compilé) sinon Symfony (API + routes du front)
	php_server
}
