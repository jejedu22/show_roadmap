# TLS géré par Traefik : FrankenPHP écoute en HTTP sur :8080.
{
	frankenphp
	auto_https off
	admin off
}

:8080 {
	root * /app/public
	encode zstd gzip

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Fichier existant (front compilé) sinon Symfony (API + routes du front)
	php_server
}
