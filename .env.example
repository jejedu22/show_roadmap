# Copier vers .env puis adapter.
APP_HOST=roadmap.example.com
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Compte administrateur créé au premier démarrage (base vide uniquement)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# Nom du réseau Docker de Traefik et de son entrypoint/resolver
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
