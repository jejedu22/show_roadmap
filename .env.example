# Copier vers .env puis adapter.
APP_HOST=roadmap.example.com
# Générer : openssl rand -hex 32
APP_SECRET=change-me
DB_PASSWORD=change-me
# Compte administrateur créé au premier démarrage (base vide uniquement)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# Réseau Docker de Traefik, entrypoint HTTPS et resolver de certificats
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Horaires SNCF open data (sans clé) : à changer seulement si la SNCF déplace le fichier
# GTFS_URL=https://eu.ftp.opendatasoft.com/sncf/plandata/Export_OpenData_SNCF_GTFS_NewTripId.zip
# Transilien et RER (gares d'Île-de-France comme Herblay) ; laisser vide pour ne pas les charger
# GTFS_IDF_URL=https://eu.ftp.opendatasoft.com/sncf/gtfs/transilien-gtfs.zip
# Lien du bouton « Ouvrir SNCF Connect » ; placeholders possibles : {origin} {destination} {date}
SNCF_CONNECT_URL=https://www.sncf-connect.com/
# Connexion Google (optionnel) ; URI de redirection : https://<APP_HOST>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
